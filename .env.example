# GreenCity AI – Environment Variables
# Copy to .env and adjust as needed.

# Application
APP_NAME=GreenCity AI
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql+psycopg://greencity:greencity@localhost:5432/greencity

# CORS (frontend Vite default)
CORS_ORIGINS=["http://localhost:5173"]

# External services (optional)
NASA_EARTHACCESS_USERNAME=
NASA_EARTHACCESS_PASSWORD=
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# Overpass (OSM) – mirrors / cache / timeouts
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_MIRROR_URLS=["https://overpass.kumi.systems/api/interpreter","https://overpass.private.coffee/api/interpreter"]
OVERPASS_TIMEOUT_S=40
OVERPASS_RETRIES_PER_MIRROR=1
OVERPASS_CACHE_TTL_S=86400
OVERPASS_CACHE_DIR=.cache/overpass

# HLS vegetation (NASA EarthAccess) – used when username/password are set
HLS_ENABLED=true
HLS_LOOKBACK_DAYS=180
HLS_MAX_CLOUD_COVER=60

# Landsat C2 L2 surface temperature (heat exposure overlay) – same EarthAccess credentials
LANDSAT_ENABLED=true
LANDSAT_LOOKBACK_DAYS=180
LANDSAT_MAX_CLOUD_COVER=60

# Auth (change JWT_SECRET in any shared / production environment)
JWT_SECRET=dev-only-change-me-greencity-jwt-secret
JWT_EXPIRE_MINUTES=10080

# Email – when EMAIL_ENABLED=false (default), summaries are logged by the stub notifier
EMAIL_ENABLED=false
EMAIL_ON_ANALYSIS_COMPLETE=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@greencity.local
SMTP_USE_TLS=true
